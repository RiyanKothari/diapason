# Copy to .env and fill in. .env is git-ignored; never commit real keys.
GNANI_API_KEY=
# Evon access: an OpenAI-compatible endpoint (Gnani-hosted, vLLM self-host, or Friendli).
EVON_BASE_URL=
EVON_API_KEY=
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B

# Optional: test agents Bhool does not run (see README "Test an agent from the outside").
# Inya (Gnani's agent platform): an API key with the agents permission; `bhool inya deploy` builds a test agent.
INYA_API_KEY=
INYA_ENVIRONMENT=development
# Real phone calls through Twilio: your account, and a Twilio number Bhool calls from (and Inya calls into).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
# Twilio must reach Bhool's phone bridge: run `cloudflared tunnel --url http://localhost:8790` and paste its https URL.
BHOOL_PUBLIC_URL=
BHOOL_BRIDGE_PORT=8790
